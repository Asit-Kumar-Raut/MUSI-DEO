rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own user profile and playlists
    match /users/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.toLowerCase() == email.toLowerCase();
      
      match /playlists/{playlistId} {
        allow read, write: if request.auth != null && request.auth.token.email.toLowerCase() == email.toLowerCase();
      }
    }
    
    // Otps collection: Only the backend server should read/write (blocked for normal client SDKs)
    match /otps/{email} {
      allow read, write: if false;
    }
  }
}
